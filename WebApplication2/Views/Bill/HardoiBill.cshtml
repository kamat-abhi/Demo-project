@model WebApplication2.Models.BillViewModel
@using System.Globalization
@{
    ViewBag.Title = "Bill " + Model.BillNo;
    ViewData["Title"] = ViewBag.Title;
    ViewData["FullWidth"] = true;
    var inr = new CultureInfo("en-IN");
    Func<decimal, string> money = v => v.ToString("N2", inr);
    Func<decimal, decimal> cg = a => Math.Round(a * Model.CgstRate / 100, 2);
    Func<decimal, decimal> sg = a => Math.Round(a * Model.SgstRate / 100, 2);
}
@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root {
            --g1: #065f46;
            --g2: #10b981;
            --soft: #ecfdf5;
            --ink: #0f172a;
            --muted: #64748b;
            --line: #d1fae5;
            --gold: #f59e0b;
        }

        * {
            box-sizing: border-box;
        }

        .bill-wrap {
            margin: 0;
            background: #dfe9e4;
            padding: 1px 0 1px;
            font-family: 'Poppins',Segoe UI,Arial,sans-serif;
            color: var(--ink);
            font-size: 12.5px;
            line-height: 1.5;
        }

        .toolbar {
            max-width: 210mm;
            margin: 16px auto 0;
            text-align: right;
        }

        .btn {
            background: var(--g1);
            color: #fff;
            border: 0;
            padding: 9px 18px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            font-family: inherit;
        }

            .btn:hover {
                background: var(--g2);
            }

        .bill {
            width: 210mm;
            min-height: 297mm;
            margin: 12px auto 32px;
            background: #fff;
            box-shadow: 0 10px 40px rgba(6,95,70,.2);
            display: grid;
            grid-template-columns: 14px 1fr;
            overflow: hidden;
        }

        .side {
            background: linear-gradient(180deg,var(--g1),var(--g2));
        }

        .main {
            padding: 0 0 24px;
            position: relative;
        }

        .top {
            background: var(--g1);
            color: #fff;
            padding: 26px 34px 22px;
            display: flex;
            justify-content: space-between;
            gap: 20px;
            position: relative;
        }

            .top::after {
                content: "";
                position: absolute;
                left: 0;
                right: 0;
                bottom: -14px;
                height: 28px;
                background: #fff;
                border-radius: 50% 50% 0 0 / 100% 100% 0 0;
            }

            .top h1 {
                margin: 0;
                font-size: 24px;
                letter-spacing: .5px;
            }

            .top p {
                margin: 2px 0 0;
                font-size: 11px;
                opacity: .85;
                max-width: 340px;
            }

        .tag {
            text-align: right;
        }

            .tag .t {
                font-size: 20px;
                font-weight: 700;
                color: #fff;
            }

            .tag .chip {
                display: inline-block;
                margin-top: 6px;
                background: var(--gold);
                color: #422006;
                font-weight: 700;
                font-size: 10.5px;
                padding: 3px 12px;
                border-radius: 999px;
                letter-spacing: .8px;
            }

        .pad {
            padding: 0 34px;
        }

        .cards {
            display: grid;
            grid-template-columns: 1.4fr 1fr;
            gap: 16px;
            margin-top: 26px;
        }

        .card {
            background: var(--soft);
            border: 1px solid var(--line);
            border-radius: 12px;
            padding: 14px 16px;
        }

        .lbl {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--g1);
            font-weight: 700;
            margin-bottom: 4px;
            display: block;
        }

        .big {
            font-weight: 700;
            font-size: 14px;
        }

        .muted {
            color: var(--muted);
        }

        .kv {
            display: grid;
            grid-template-columns: auto 1fr;
            gap: 3px 12px;
        }

            .kv b {
                color: var(--muted);
                font-weight: 500;
            }

        .tbl {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            margin-top: 20px;
            border: 1px solid var(--line);
            border-radius: 12px;
            overflow: hidden;
        }

            .tbl th {
                background: var(--g1);
                color: #fff;
                font-size: 10.5px;
                text-transform: uppercase;
                letter-spacing: .6px;
                padding: 10px 8px;
                text-align: left;
            }

            .tbl td {
                padding: 8px;
                border-bottom: 1px solid var(--line);
            }

            .tbl tbody tr:nth-child(even) td {
                background: #f7fdfa;
            }

            .tbl .sub {
                color: var(--muted);
                font-size: 10.5px;
            }

        .num {
            text-align: right !important;
            white-space: nowrap;
            font-variant-numeric: tabular-nums;
        }

        .ctr {
            text-align: center !important;
        }

        .tbl tfoot td {
            background: var(--soft);
            font-weight: 700;
            border-bottom: 0;
            padding: 11px 8px;
        }

        .grand {
            margin-top: 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
        }

        .words {
            flex: 1;
            border-left: 4px solid var(--gold);
            background: #fffbeb;
            border-radius: 0 10px 10px 0;
            padding: 10px 14px;
        }

        .total {
            background: linear-gradient(90deg,var(--g1),var(--g2));
            color: #fff;
            border-radius: 12px;
            padding: 12px 22px;
            text-align: right;
            min-width: 220px;
        }

            .total small {
                display: block;
                font-size: 10px;
                letter-spacing: 1px;
                text-transform: uppercase;
                opacity: .85;
            }

            .total strong {
                font-size: 22px;
            }

        .foot {
            display: grid;
            grid-template-columns: 1.3fr 1fr;
            gap: 18px;
            margin-top: 24px;
            align-items: end;
        }

        .terms {
            font-size: 11px;
            color: var(--muted);
        }

            .terms h4 {
                margin: 0 0 4px;
                color: var(--g1);
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: 1px;
            }

        .sign {
            text-align: center;
        }

            .sign .space {
                height: 70px;
            }

            .sign .line {
                border-top: 1px solid var(--ink);
                padding-top: 6px;
                font-weight: 600;
                font-size: 12px;
            }

        @@media print {
            .bill-wrap {
                background: #fff;
                padding: 0;
            }

            .toolbar {
                display: none;
            }

            .bill {
                box-shadow: none;
                margin: 0;
                width: 100%;
                min-height: auto;
            }

            * {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            @@page {
                size: A4;
                margin: 0;
            }
        }

        @@media screen and (max-width: 820px) {
            .bill {
                width: 100%;
            }

            .cards, .foot {
                grid-template-columns: 1fr;
            }

            .grand {
                flex-direction: column;
                align-items: stretch;
            }

            .pad {
                overflow-x: auto;
            }

            .top {
                flex-direction: column;
            }

            .tag {
                text-align: left;
            }
        }
    </style>
}

<div class="bill-wrap">
    <div class="toolbar"><button class="btn" onclick="window.print()">Print / Save PDF</button></div>
    <div class="bill" data-a4>
        <div class="side"></div>
        <div class="main">
            <div class="top">
                <div>
                    <h1>@Model.CompanyName</h1>
                    <p>@Model.CompanyAddress</p>
                    <p>Phone: @Model.CompanyPhone &nbsp;|&nbsp; @Model.CompanyEmail</p>
                </div>
                <div class="tag">
                    <div class="t">@Model.Title</div>
                    <span class="chip">BILL NO. @Model.BillNo</span>
                </div>
            </div>

            <div class="pad">
                <div class="cards">
                    <div class="card">
                        <span class="lbl">To</span>
                        <div class="big">@Model.BilledToName</div>
                        <div class="muted">@Model.BilledToAddress</div>
                    </div>
                    <div class="card kv">
                        <b>Bill Date</b><span>@Model.BillDate.ToString("dd/MM/yyyy")</span>
                        <b>Order No.</b><span>@Model.OrderNo</span>
                        @if (Model.OrderDate.HasValue)
                        {
                            <b>Order Date</b><span>@Model.OrderDate.Value.ToString("dd-MM-yyyy")</span>
                        }
                    </div>
                </div>

                <table class="tbl">
                    <thead>
                        <tr>
                            <th class="ctr" style="width:36px">S.No</th>
                            <th>Depot / Description</th>
                            <th class="num">Amount (₹)</th>
                            <th class="num">@Model.CgstRate.ToString("0.##")% CGST</th>
                            <th class="num">@Model.SgstRate.ToString("0.##")% SGST</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int n = 0;
                        }
                        @foreach (var it in Model.Items)
                        {
                            n++;
                            <tr>
                                <td class="ctr">@n</td>
                                <td>
                                    <b>@(string.IsNullOrWhiteSpace(it.Depot) ? it.Description : it.Depot)</b>
                                    @if (!string.IsNullOrWhiteSpace(it.Depot))
                                    {
                                        <div class="sub">@it.Description</div>
                                    }
                                </td>
                                <td class="num">@money(it.Amount)</td>
                                <td class="num">@money(cg(it.Amount))</td>
                                <td class="num">@money(sg(it.Amount))</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td></td>
                            <td>TOTAL</td>
                            <td class="num">@money(Model.SubTotal)</td>
                            <td class="num">@money(Model.Cgst)</td>
                            <td class="num">@money(Model.Sgst)</td>
                        </tr>
                    </tfoot>
                </table>

                <div class="grand">
                    <div class="words"><span class="lbl">Amount in words</span>@Model.AmountInWords</div>
                    <div class="total"><small>Grand Total</small><strong>₹ @money(Model.GrandTotal)</strong></div>
                </div>

                <div class="foot">
                    <div class="terms">
                        <h4>Terms &amp; Conditions</h4>
                        @foreach (var t in Model.Terms)
                        {
                            <div>@t</div>
                        }
                    </div>
                    <div class="sign">
                        <div class="muted">For <b>@Model.CompanyName</b></div>
                        <div class="space"></div>
                        <div class="line">@Model.SignatoryName</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
