@model WebApplication2.Models.BillViewModel
@using System.Globalization
@{
    ViewBag.Title = "Invoice " + Model.BillNo;
    ViewData["Title"] = ViewBag.Title;
    ViewData["FullWidth"] = true;
    var inr = new CultureInfo("en-IN");
    Func<decimal, string> money = v => v.ToString("N2", inr);
    bool hasDepot = Model.Items.Any(i => !string.IsNullOrWhiteSpace(i.Depot));
    bool hasHsn = Model.Items.Any(i => !string.IsNullOrWhiteSpace(i.HsnCode));
    bool hasShip = !string.IsNullOrWhiteSpace(Model.ShippedToName);
}
@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet" />
    <style>
        :root {
            --brand: #1e3a8a;
            --brand-2: #3b82f6;
            --ink: #111827;
            --muted: #6b7280;
            --line: #e5e7eb;
            --soft: #f3f6fd;
        }

        * {
            box-sizing: border-box;
        }

        .bill-wrap {
            margin: 0;
            background: #e9edf5;
            padding: 1px 0 1px;
            font-family: 'Inter', Segoe UI, Arial, sans-serif;
            color: var(--ink);
            font-size: 13px;
            line-height: 1.5;
        }

        .toolbar {
            max-width: 210mm;
            margin: 16px auto 0;
            text-align: right;
        }

        .btn {
            background: var(--brand);
            color: #fff;
            border: 0;
            padding: 9px 18px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            font-family: inherit;
        }

            .btn:hover {
                background: var(--brand-2);
            }

        .invoice {
            width: 210mm;
            min-height: 297mm;
            margin: 12px auto 32px;
            background: #fff;
            box-shadow: 0 10px 40px rgba(30,58,138,.18);
            position: relative;
            overflow: hidden;
        }

            .invoice::before {
                content: "";
                display: block;
                height: 10px;
                background: linear-gradient(90deg, var(--brand), var(--brand-2));
            }

        .head {
            display: flex;
            justify-content: space-between;
            gap: 24px;
            padding: 28px 36px 18px;
        }

        .brand h1 {
            font-family: 'Playfair Display', serif;
            font-size: 26px;
            margin: 0 0 6px;
            color: var(--brand);
        }

        .brand p {
            margin: 0;
            color: var(--muted);
            font-size: 12px;
        }

        .doc-title {
            text-align: right;
        }

            .doc-title .title {
                font-size: 30px;
                font-weight: 700;
                letter-spacing: 2px;
                text-transform: uppercase;
                color: var(--brand);
                margin: 0;
            }

        .badge {
            display: inline-block;
            margin-top: 6px;
            padding: 3px 12px;
            border-radius: 999px;
            background: var(--soft);
            color: var(--brand);
            font-size: 11px;
            font-weight: 600;
        }

        .gstin {
            margin-top: 8px;
            font-size: 12px;
            font-weight: 600;
        }

        .meta {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0;
            margin: 0 36px;
            border: 1px solid var(--line);
            border-radius: 10px;
            background: var(--soft);
        }

            .meta div {
                padding: 12px 16px;
                border-right: 1px solid var(--line);
            }

                .meta div:last-child {
                    border-right: 0;
                }

        .label {
            display: block;
            font-size: 10.5px;
            text-transform: uppercase;
            letter-spacing: .8px;
            color: var(--muted);
            font-weight: 600;
            margin-bottom: 2px;
        }

        .value {
            font-weight: 600;
        }

        .parties {
            display: grid;
            grid-template-columns: @(hasShip ? "1fr 1fr" : "1fr");
            gap: 18px;
            padding: 22px 36px 6px;
        }

        .party {
            border-left: 4px solid var(--brand-2);
            padding: 4px 0 4px 14px;
        }

            .party h3 {
                margin: 0 0 4px;
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: 1px;
                color: var(--brand);
            }

            .party .name {
                font-weight: 700;
                font-size: 14px;
            }

            .party .addr {
                color: var(--muted);
            }

        .items {
            padding: 18px 36px 0;
        }

        table.tbl {
            width: 100%;
            border-collapse: collapse;
        }

            table.tbl thead th {
                background: var(--brand);
                color: #fff;
                padding: 10px 12px;
                font-size: 11.5px;
                text-transform: uppercase;
                letter-spacing: .6px;
                text-align: left;
            }

                table.tbl thead th:first-child {
                    border-radius: 8px 0 0 8px;
                }

                table.tbl thead th:last-child {
                    border-radius: 0 8px 8px 0;
                }

            table.tbl tbody td {
                padding: 11px 12px;
                border-bottom: 1px solid var(--line);
                vertical-align: top;
            }

            table.tbl tbody tr:nth-child(even) td {
                background: #fafbff;
            }

        .num {
            text-align: right !important;
            white-space: nowrap;
            font-variant-numeric: tabular-nums;
        }

        .ctr {
            text-align: center !important;
        }

        .summary {
            display: flex;
            justify-content: space-between;
            gap: 24px;
            padding: 18px 36px 0;
            align-items: flex-start;
        }

        .words {
            flex: 1;
            background: var(--soft);
            border-radius: 10px;
            padding: 12px 16px;
        }

            .words .value {
                font-style: italic;
            }

        .totals {
            width: 290px;
        }

            .totals .row {
                display: flex;
                justify-content: space-between;
                padding: 6px 4px;
                border-bottom: 1px dashed var(--line);
            }

            .totals .grand {
                margin-top: 8px;
                background: linear-gradient(90deg, var(--brand), var(--brand-2));
                color: #fff;
                border-radius: 10px;
                padding: 12px 16px;
                display: flex;
                justify-content: space-between;
                font-size: 16px;
                font-weight: 700;
                border: 0;
            }

        .foot {
            display: grid;
            grid-template-columns: 1.3fr 1fr;
            gap: 24px;
            padding: 26px 36px 30px;
        }

        .box {
            border: 1px solid var(--line);
            border-radius: 10px;
            padding: 14px 16px;
        }

            .box h4 {
                margin: 0 0 8px;
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: 1px;
                color: var(--brand);
            }

        .kv {
            display: grid;
            grid-template-columns: 90px 1fr;
            gap: 2px 8px;
            font-size: 12.5px;
        }

            .kv span:nth-child(odd) {
                color: var(--muted);
            }

        .terms {
            margin: 10px 0 0;
            padding-left: 16px;
            color: var(--muted);
            font-size: 11.5px;
        }

        .sign {
            text-align: center;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 150px;
        }

            .sign img {
                max-height: 90px;
                margin: 6px auto;
                opacity: .9;
            }

            .sign .line {
                border-top: 1px solid var(--ink);
                padding-top: 6px;
                font-weight: 600;
                font-size: 12px;
            }

        .thanks {
            text-align: center;
            color: var(--muted);
            font-size: 11px;
            padding-bottom: 20px;
        }

        @@media print {
            .bill-wrap {
                background: #fff;
                padding: 0;
            }

            .toolbar {
                display: none;
            }

            .invoice {
                box-shadow: none;
                margin: 0;
                width: 100%;
                min-height: auto;
            }

            * {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            @@page {
                size: A4;
                margin: 0;
            }
        }

        @@media screen and (max-width: 820px) {
            .invoice {
                width: 100%;
            }

            .head, .summary, .foot {
                flex-direction: column;
                grid-template-columns: 1fr;
            }

            .meta, .parties {
                grid-template-columns: 1fr;
            }

            .totals {
                width: 100%;
            }

            .items {
                overflow-x: auto;
            }
        }
    </style>
}

<div class="bill-wrap">
    <div class="toolbar"><button class="btn" onclick="window.print()">Print / Save PDF</button></div>

    <div class="invoice" data-a4>
        <div class="head">
            <div class="brand">
                <h1>@Model.CompanyName</h1>
                @if (!string.IsNullOrWhiteSpace(Model.CompanyAddress))
                {
                    <p>@Model.CompanyAddress</p>
                }
                @if (!string.IsNullOrWhiteSpace(Model.CompanyPhone))
                {
                    <p>Phone: @Model.CompanyPhone</p>
                }
                @if (!string.IsNullOrWhiteSpace(Model.CompanyEmail))
                {
                    <p>@Model.CompanyEmail</p>
                }
            </div>
            <div class="doc-title">
                <p class="title">@Model.Title</p>
                @if (!string.IsNullOrWhiteSpace(Model.CopyType))
                {
                    <span class="badge">@Model.CopyType</span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Gstin))
                {
                    <div class="gstin">GSTIN: @Model.Gstin</div>
                }
            </div>
        </div>

        <div class="meta">
            <div><span class="label">Invoice No.</span><span class="value">@Model.BillNo</span></div>
            <div><span class="label">Date</span><span class="value">@Model.BillDate.ToString("dd-MM-yyyy")</span></div>
            <div>
                <span class="label">Work / Order No.</span>
                <span class="value">@(string.IsNullOrWhiteSpace(Model.OrderNo) ? "—" : Model.OrderNo)</span>
                @if (Model.OrderDate.HasValue)
                {
                    <div style="padding:0;border:0;color:var(--muted);font-size:11.5px">Dated: @Model.OrderDate.Value.ToString("dd/MM/yyyy")</div>
                }
            </div>
        </div>

        <div class="parties">
            <div class="party">
                <h3>Billed to</h3>
                <div class="name">@Model.BilledToName</div>
                <div class="addr">@Model.BilledToAddress</div>
            </div>
            @if (hasShip)
            {
                <div class="party">
                    <h3>Shipped to</h3>
                    <div class="name">@Model.ShippedToName</div>
                    <div class="addr">@Model.ShippedToAddress</div>
                </div>
            }
        </div>

        <div class="items">
            <table class="tbl">
                <thead>
                    <tr>
                        <th class="ctr" style="width:48px">#</th>
                        <th>Description of Goods</th>
                        @if (hasDepot)
                        {
                            <th>Depot</th>
                        }
                        @if (hasHsn)
                        {
                            <th class="ctr">HSN</th>
                        }
                        <th class="ctr">Qty</th>
                        <th class="num">Rate (₹)</th>
                        <th class="num">Amount (₹)</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int n = 0;
                    }
                    @foreach (var item in Model.Items)
                    {
                        n++;
                        <tr>
                            <td class="ctr">@n</td>
                            <td>@item.Description</td>
                            @if (hasDepot)
                            {
                                <td>@item.Depot</td>
                            }
                            @if (hasHsn)
                            {
                                <td class="ctr">@item.HsnCode</td>
                            }
                            <td class="ctr">@item.Quantity.ToString("0.##")</td>
                            <td class="num">@money(item.Rate)</td>
                            <td class="num">@money(item.Amount)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="summary">
            <div class="words">
                <span class="label">Amount chargeable (in words)</span>
                <span class="value">@Model.AmountInWords</span>
            </div>
            <div class="totals">
                <div class="row"><span>Total</span><span>@money(Model.SubTotal)</span></div>
                <div class="row"><span>SGST @@ @Model.SgstRate.ToString("0.##")%</span><span>@money(Model.Sgst)</span></div>
                <div class="row"><span>CGST @@ @Model.CgstRate.ToString("0.##")%</span><span>@money(Model.Cgst)</span></div>
                @if (Model.RoundedTotal != Model.GrandTotal)
                {
                    <div class="row"><span>Grand Total</span><span>@money(Model.GrandTotal)</span></div>
                }
                <div class="grand"><span>@(Model.RoundedTotal != Model.GrandTotal ? "Rounded Total" : "Grand Total")</span><span>₹ @money(Model.RoundedTotal)</span></div>
            </div>
        </div>

        <div class="foot">
            <div>
                <div class="box">
                    <h4>Bank Details</h4>
                    <div class="kv">
                        <span>A/c No.</span><span>@Model.BankAccountNo</span>
                        <span>Bank</span><span>@Model.BankName</span>
                        <span>IFSC</span><span>@Model.Ifsc</span>
                        <span>Branch</span><span>@Model.Branch</span>
                        <span>PAN</span><span>@Model.Pan</span>
                    </div>
                </div>
                @if (Model.Terms.Any())
                {
                    <div class="box" style="margin-top:12px">
                        <h4>Terms &amp; Conditions</h4>
                        <ol class="terms">
                            @foreach (var t in Model.Terms)
                            {
                                <li>@t</li>
                            }
                        </ol>
                    </div>
                }
            </div>
            <div class="box sign">
                <div><h4>For @Model.CompanyName</h4></div>
                @if (!string.IsNullOrWhiteSpace(Model.StampUrl))
                {
                    <img src="@Url.Content(Model.StampUrl)" alt="Stamp and signature" />
                }
                <div class="line">@(string.IsNullOrWhiteSpace(Model.SignatoryName) ? "Authorised Signatory" : Model.SignatoryName)</div>
            </div>
        </div>

        <div class="thanks">Thank you for your business.</div>
    </div>
</div>
