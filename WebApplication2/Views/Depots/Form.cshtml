@model WebApplication2.Models.Depot
@{ ViewData["Title"] = "Depot"; }
<h3 class="mt-4">@(Model.DepotId == 0 ? "Add" : "Edit") Depot</h3>
<form asp-action="@(Model.DepotId == 0 ? "Create" : "Edit")" method="post" class="col-md-7">
    <input type="hidden" asp-for="DepotId" />
    <div class="mb-3"><label asp-for="ClientId" class="form-label">Client</label>
        <select asp-for="ClientId" asp-items="(SelectList)ViewBag.Clients" class="form-select"><option value="">-- select --</option></select></div>
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Active</label></div>
    <partial name="_FormButtons" />
</form>
