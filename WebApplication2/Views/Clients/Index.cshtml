@model IEnumerable<WebApplication2.Models.Client>
@{ ViewData["Title"] = "Clients"; }
<partial name="_MasterHeader" />
<table class="table table-hover align-middle">
    <thead class="table-light"><tr><th>Name</th><th>Address</th><th>GSTIN</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var x in Model)
    {
        <tr class="@(x.IsActive ? "" : "text-muted")">
            <td>@x.Name</td><td>@x.Address</td><td>@x.Gstin</td><td>@(x.IsActive ? "Active" : "Inactive")</td>
            <td class="text-end text-nowrap">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@x.ClientId">Edit</a>
                <form asp-action="Toggle" asp-route-id="@x.ClientId" method="post" class="d-inline">
                    <button class="btn btn-sm @(x.IsActive ? "btn-outline-danger" : "btn-outline-success")">@(x.IsActive ? "Deactivate" : "Activate")</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
