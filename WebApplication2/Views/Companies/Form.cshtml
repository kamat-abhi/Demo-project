@model WebApplication2.Models.Company
@{ ViewData["Title"] = "Company"; }
<h3 class="mt-4">@(Model.CompanyId == 0 ? "Add" : "Edit") Company</h3>
<form asp-action="@(Model.CompanyId == 0 ? "Create" : "Edit")" method="post" class="col-md-9">
    <input type="hidden" asp-for="CompanyId" />
    <div class="row">
        <div class="col-md-6 mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
        <div class="col-md-6 mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /></div>
    </div>
    <div class="mb-3"><label asp-for="Address" class="form-label"></label><textarea asp-for="Address" rows="2" class="form-control"></textarea><span asp-validation-for="Address" class="text-danger"></span></div>
    <div class="row">
        <div class="col-md-4 mb-3"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /></div>
        <div class="col-md-4 mb-3"><label asp-for="Gstin" class="form-label">GSTIN</label><input asp-for="Gstin" class="form-control" /></div>
        <div class="col-md-4 mb-3"><label asp-for="Pan" class="form-label">PAN</label><input asp-for="Pan" class="form-control" /></div>
    </div>
    <h6 class="mt-2">Bank details</h6>
    <div class="row">
        <div class="col-md-3 mb-3"><label asp-for="BankName" class="form-label"></label><input asp-for="BankName" class="form-control" /></div>
        <div class="col-md-3 mb-3"><label asp-for="BankAccountNo" class="form-label">Account No.</label><input asp-for="BankAccountNo" class="form-control" /></div>
        <div class="col-md-3 mb-3"><label asp-for="Ifsc" class="form-label">IFSC</label><input asp-for="Ifsc" class="form-control" /></div>
        <div class="col-md-3 mb-3"><label asp-for="Branch" class="form-label"></label><input asp-for="Branch" class="form-control" /></div>
    </div>
    <div class="mb-3"><label asp-for="StampUrl" class="form-label">Stamp image path (e.g. ~/img/1.png)</label><input asp-for="StampUrl" class="form-control" /></div>
    <div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Active</label></div>
    <partial name="_FormButtons" />
</form>
