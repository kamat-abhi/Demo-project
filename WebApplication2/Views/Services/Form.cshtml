@model WebApplication2.Models.Service
@{ ViewData["Title"] = "Service"; }
<h3 class="mt-4">@(Model.ServiceId == 0 ? "Add" : "Edit") Service / Item</h3>
<form asp-action="@(Model.ServiceId == 0 ? "Create" : "Edit")" method="post" class="col-md-7">
    <input type="hidden" asp-for="ServiceId" />
    <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" rows="2" class="form-control"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
    <div class="row">
        <div class="col-md-6 mb-3"><label asp-for="HsnCode" class="form-label">HSN / SAC code</label><input asp-for="HsnCode" class="form-control" /></div>
        <div class="col-md-6 mb-3"><label asp-for="DefaultRate" class="form-label"></label><input asp-for="DefaultRate" type="number" step="0.01" class="form-control" /></div>
    </div>
    <div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Active</label></div>
    <partial name="_FormButtons" />
</form>
